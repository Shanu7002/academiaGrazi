rules_version = '2';

// ETAPA 5 - PROPOSTA PARA TESTE NO FIRESTORE EMULATOR.
// NAO PUBLICAR EM PRODUCAO SEM PASSAR NOS TESTES E REVISAR FLUXOS EXISTENTES.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.type == 'admin';
    }

    function isValidInstructor(userId) {
      return userId is string
        && userId.size() > 0
        && exists(userPath(userId))
        && get(userPath(userId)).data.type == 'instructor';
    }

    function linkedInstructor(studentId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.type == 'instructor'
        && exists(userPath(studentId))
        && get(userPath(studentId)).data.type == 'user'
        && get(userPath(studentId)).data.responsable == request.auth.uid;
    }

    function canReadStudentData(studentId) {
      return ownUser(studentId) || linkedInstructor(studentId) || isAdmin();
    }

    function planPath(studentId, planId) {
      return /databases/$(database)/documents/users/$(studentId)/trainingPlans/$(planId);
    }

    function currentPlanPath(studentId) {
      return /databases/$(database)/documents/users/$(studentId)/trainingState/current;
    }

    match /users/{userId} {
      // Permissoes de leitura existentes, preservadas.
      allow read: if ownUser(userId);
      allow read: if signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.responsable == userId;
      allow read: if signedIn() && resource.data.responsable == request.auth.uid;
      allow read: if isAdmin();

      // Autocadastro: aluno nao pode criar perfil de admin/instrutor.
      // O codigo de convite continua sendo validado no fluxo existente;
      // esta regra verifica apenas que o instrutor indicado existe.
      allow create: if ownUser(userId)
        && request.resource.data.keys().hasAll(['name', 'type', 'responsable'])
        && request.resource.data.type == 'user'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && isValidInstructor(request.resource.data.responsable);

      // Edicao do proprio perfil: permite apenas dados de perfil, sem
      // modificar papel, vinculo, codigo de convite, email ou timestamps.
      allow update: if ownUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'photoUrl', 'registrationProfile'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Mantem a renovacao de codigo feita pelo administrador.
      allow update: if isAdmin()
        && resource.data.type == 'instructor'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['registrationCode', 'registrationCodeExpiresAt']);

      // Mantem a criacao do professor pelo administrador.
      allow create: if isAdmin()
        && request.resource.data.type == 'instructor'
        && request.resource.data.responsable == request.auth.uid;

      allow delete: if false;
    }

    // Lógica existente de códigos de convite - preservada.
    match /instructorCodes/{code} {
      allow get: if true;
      allow list: if false;

      function isValidCode(data) {
        return code.matches('^[0-9]{4}$')
          && data.active == true
          && data.instructorName is string
          && data.instructorName.size() > 0
          && data.expiresAtMillis is int
          && data.keys().hasOnly([
            'instructorId',
            'instructorName',
            'active',
            'createdAt',
            'expiresAtMillis'
          ]);
      }

      function canIssueFor(instructorId) {
        return signedIn()
          && getAfter(userPath(instructorId)).data.type == 'instructor'
          && (request.auth.uid == instructorId || isAdmin());
      }

      function isFree() {
        return resource == null
          || resource.data.instructorId == request.resource.data.instructorId
          || resource.data.active != true
          || !('expiresAtMillis' in resource.data)
          || resource.data.expiresAtMillis < request.time.toMillis();
      }

      allow create: if canIssueFor(request.resource.data.instructorId)
        && isValidCode(request.resource.data);

      allow update: if (
          canIssueFor(request.resource.data.instructorId)
          && isFree()
          && isValidCode(request.resource.data)
        ) || (
          signedIn()
          && (request.auth.uid == resource.data.instructorId || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active'])
          && request.resource.data.active == false
        );

      allow delete: if false;
    }

    // Mantido: aulas publicadas somente para leitura.
    match /gym_classes/{classId} {
      allow read: if signedIn();
      allow write: if false;
    }

    function validNewTrainingPlan(studentId, planId) {
      return linkedInstructor(studentId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'id', 'studentId', 'instructorId',
          'name', 'version', 'status', 'routines', 'weeklySchedule',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'id', 'studentId', 'instructorId',
          'name', 'version', 'status', 'routines', 'weeklySchedule',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id == planId
        && request.resource.data.studentId == studentId
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.status == 'draft'
        && request.resource.data.version == 1
        && request.resource.data.routines is list
        && request.resource.data.routines.size() <= 12
        && request.resource.data.weeklySchedule is map
        && request.resource.data.weeklySchedule.size() <= 7
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{studentId}/trainingPlans/{planId} {
      // Professor vinculado le seus rascunhos; aluno le SOMENTE publicadas.
      // Consultas do aluno devem filtrar status='published'.
      allow get, list: if linkedInstructor(studentId)
        || isAdmin()
        || (ownUser(studentId) && resource.data.status == 'published');

      allow create: if validNewTrainingPlan(studentId, planId);

      // Rascunho: atualizacao controlada e versao incrementada.
      allow update: if linkedInstructor(studentId)
        && resource.data.status == 'draft'
        && resource.data.id == planId
        && resource.data.studentId == studentId
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.instructorId == resource.data.instructorId
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            request.resource.data.status == 'draft'
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 160
            && request.resource.data.routines is list
            && request.resource.data.routines.size() <= 12
            && request.resource.data.weeklySchedule is map
            && request.resource.data.weeklySchedule.size() <= 7
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name','routines','weeklySchedule','version','updatedAt'])
          )
          ||
          (
            // Publicacao exige transacao com trainingState/current.
            request.resource.data.status == 'published'
            && request.resource.data.version == resource.data.version
            && request.resource.data.routines is list
            && request.resource.data.routines.size() > 0
            && request.resource.data.weeklySchedule is map
            && request.resource.data.weeklySchedule.size() > 0
            && request.resource.data.publishedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'publishedAt', 'updatedAt'])
            && getAfter(currentPlanPath(studentId)).data.activePlanId == planId
            && getAfter(currentPlanPath(studentId)).data.instructorId == request.auth.uid
            && getAfter(currentPlanPath(studentId)).data.updatedAt == request.time
          )
        );

      // Apos publicar, a ficha se torna imutavel.
      allow delete: if false;
    }

    match /users/{studentId}/trainingState/{stateId} {
      // Apenas o ponteiro 'current', nunca uma lista arbitraria de estados.
      allow get: if stateId == 'current'
        && canReadStudentData(studentId);
      allow list: if false;

      allow create, update: if stateId == 'current'
        && linkedInstructor(studentId)
        && request.resource.data.keys().hasOnly([
          'activePlanId', 'instructorId', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'activePlanId', 'instructorId', 'updatedAt'
        ])
        && request.resource.data.activePlanId is string
        && request.resource.data.activePlanId.size() > 0
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && getAfter(planPath(studentId, request.resource.data.activePlanId)).data.status == 'published'
        && getAfter(planPath(studentId, request.resource.data.activePlanId)).data.instructorId == request.auth.uid
        && getAfter(planPath(studentId, request.resource.data.activePlanId)).data.publishedAt == request.time;

      allow delete: if false;
    }

    // Nenhuma permissao ainda para trainingSessions e exerciseCatalog.
    // Criar regras especificas quando os respectivos servicos existirem.
  }
}
